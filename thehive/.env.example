# Copier ce fichier en ".env" (jamais commité) puis remplacer UID, GID et le mot de passe.

# System variables
## UID = résultat de la commande "id -u", GID = résultat de "id -g"
UID=1000
GID=1000

# ElasticSearch password (même valeur que dans thehive/config/index.conf)
elasticsearch_password = 'YOUR_ELASTICSEARCH_PASSWORD'

# Containers versions (versions du lab)
cassandra_image_version = '4.1.11'
elasticsearch_image_version = '8.19.15'
thehive_image_version = '5.7.3'
cortex_image_version = '4.0.1'
nginx_image_version = '1.31.1'

# Nginx configuration
nginx_server_name="thehive"
nginx_ssl_trusted_certificate=""
